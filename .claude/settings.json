{
  "hooks": {
    "PostToolUse": [
      {
        "pattern": "*.md",
        "command": "npx markdownlint-cli2 $CLAUDE_FILE || true"
      },
      {
        "pattern": "*.json",
        "command": "python3 -m json.tool $CLAUDE_FILE > /dev/null 2>&1 || echo 'Invalid JSON: '$CLAUDE_FILE"
      }
    ]
  }
}
